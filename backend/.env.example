NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Origens exatas do frontend local; não use * nem null em produção.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500
TRUST_PROXY=false
BODY_LIMIT_BYTES=100000
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
CONTACT_RETENTION_DAYS=180
